# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/tripzobox

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_for_security
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_signing_secret_key_here

# Frontend URL for CORS
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Uploads Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Optional SMTP Configuration (Leave empty to use simulated verification in development)
# To send real emails to Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_google_app_password
# SMTP_FROM="TripzoBox" <your_email@gmail.com>


